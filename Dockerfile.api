FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md /app/
COPY src/harborbox /app/src/harborbox
COPY src/harborbox_sdk /app/src/harborbox_sdk

RUN pip install --upgrade pip \
    && pip install .

EXPOSE 8000
CMD ["uvicorn", "harborbox.main:app", "--host", "0.0.0.0", "--port", "8000"]


---
title: "Harborbox sandbox start against DELETE"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: ok
  }
  class lg0 blue
  state "At the same time" as all {
    state "Row" as r0 {
      s0: Starting
      s1: Deleted
      s2: Running, knows its container
      s3: Deleted, knows its container
      [*] --> s0
      s0 --> s1: you delete the sandbox
      s0 --> s2: the start saves running [when Container up]
      s2 --> s3: you delete the sandbox
      s3 --> s1: DELETE saves killed [when No container]
    }
    --
    state "Container" as r1 {
      s4: No container
      s5: Container up
      [*] --> s4
      s4 --> s5: OpenSandbox creates the container [unless Deleted, knows its container]
      s5 --> s4: the start saves running [when Deleted]
      s5 --> s4: DELETE kills what it knows of [when Deleted or Deleted, knows its container]
    }
  }
  class s0 blue
  class s2 blue
  class s4 blue

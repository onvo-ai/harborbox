.DS_Store
.env
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
__pycache__/
*.py[cod]
dist/
build/
# Installed when typechecking the TypeScript SDK; never part of a commit.
node_modules/
.coverage
htmlcov/

# Backups written in place during deploys. Never committable.
.env.bak.*
*.bak
*.pre-guard

# CI-generated report artifacts (coverage, unit test results, strict lint
# backlog, e2e results, the rendered PR report).
/coverage.json
/unit-results.json
/ruff-strict.json
/e2e-results.json
/ci-report.md

# The bundled registry's htpasswd file. Generated per deployment from
# HARBORBOX_REGISTRY_USERNAME/_PASSWORD; it is a credential, not config.
auth/

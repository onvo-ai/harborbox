HARBORBOX_API_KEY=replace-with-a-long-random-secret
HARBORBOX_EXECUTION_SECRET_KEY=replace-with-another-long-random-secret
OPENSANDBOX_API_KEY=replace-with-a-separate-long-random-secret
POSTGRES_PASSWORD=replace-with-a-long-random-secret
HARBORBOX_PORT=8000
# Linux default. OrbStack users should set this to:
# /Users/<your-user>/.orbstack/run/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# Harborbox is the durable scheduler; OpenSandbox owns runtime lifecycle.
HARBORBOX_OPENSANDBOX_DOMAIN=opensandbox:8080
HARBORBOX_OPENSANDBOX_PROTOCOL=http
HARBORBOX_OPENSANDBOX_USE_SERVER_PROXY=true
HARBORBOX_OPENSANDBOX_READY_TIMEOUT_SECONDS=30
HARBORBOX_OPENSANDBOX_SNAPSHOT_TIMEOUT_SECONDS=300

# Immutable dependency-baked templates. Use a release or commit identifier in
# production and publish the same tag for every host architecture you operate.
HARBORBOX_TEMPLATE_IMAGE_PREFIX=harborbox-sandbox
HARBORBOX_TEMPLATE_VERSION=local

# Derived, content-hashed templates (POST /v1/templates). A caller layers apt
# and npm packages onto a static base; identical requirement sets share one
# image. The Dockerfile is generated from request input, so every package name
# is regex-checked AND must appear in these allowlists. Names are verified
# against Debian bookworm, which is what the base images are built from.
HARBORBOX_TEMPLATE_APT_ALLOWLIST=["ca-certificates","chromium","default-mysql-client","fonts-liberation","fonts-noto-core","postgresql-client","redis-tools"]
HARBORBOX_TEMPLATE_NPM_ALLOWLIST=["@playwright/mcp"]
HARBORBOX_TEMPLATE_MAX_APT_PACKAGES=40
HARBORBOX_TEMPLATE_MAX_NPM_PACKAGES=20
HARBORBOX_TEMPLATE_MAX_ENV_VARS=32
HARBORBOX_TEMPLATE_MAX_ENV_VALUE_LENGTH=1024
HARBORBOX_TEMPLATE_BUILD_TIMEOUT_SECONDS=1800
# Derived images with no sandbox use in this many days are removed by a sweep in
# the existing reaper loop. Static templates are never collected.
HARBORBOX_TEMPLATE_GC_ENABLED=true
HARBORBOX_TEMPLATE_GC_MAX_IDLE_DAYS=14
HARBORBOX_TEMPLATE_GC_INTERVAL_SECONDS=3600

# PostgreSQL-coordinated adaptive warm pools. These reservations count toward the
# aggregate sandbox budget even after an inactive pool scales to zero, so it can
# safely refill without racing queued-job admission over the configured cap.
HARBORBOX_WARM_POOL_ENABLED=true
HARBORBOX_WARM_POOL_RELAYDECK=2
HARBORBOX_WARM_POOL_ONVO_PRO=1
HARBORBOX_WARM_POOL_ONVO_LITE=0
HARBORBOX_WARM_POOL_WARMUP_CONCURRENCY=2
HARBORBOX_WARM_POOL_RECONCILE_SECONDS=2
HARBORBOX_WARM_POOL_IDLE_TTL_SECONDS=900
HARBORBOX_WARM_POOL_RELEASE_AFTER_INACTIVITY_SECONDS=300
HARBORBOX_WARM_POOL_RELEASE_ON_SHUTDOWN=true

HARBORBOX_RELAYDECK_TEMPLATE_MEMORY_MB=256
HARBORBOX_RELAYDECK_TEMPLATE_CPU=0.5
HARBORBOX_ONVO_PRO_TEMPLATE_MEMORY_MB=1024
HARBORBOX_ONVO_PRO_TEMPLATE_CPU=2
HARBORBOX_ONVO_LITE_TEMPLATE_MEMORY_MB=1024
HARBORBOX_ONVO_LITE_TEMPLATE_CPU=2

# Resource admission
HARBORBOX_HOST_MEMORY_RESERVE_PERCENT=25
HARBORBOX_HOST_MEMORY_RESERVE_MIN_MB=1024
HARBORBOX_PLATFORM_MEMORY_RESERVE_MB=512
HARBORBOX_EMERGENCY_AVAILABLE_MEMORY_MB=512
# Absolute aggregate sandbox ceiling. This is not preallocated; idle usage is 0.
HARBORBOX_SANDBOX_MEMORY_BUDGET_MB=4096
HARBORBOX_DEFAULT_SANDBOX_MEMORY_MB=512
HARBORBOX_MAX_SANDBOX_MEMORY_MB=4096
HARBORBOX_MAX_PARALLEL_CPU=4
HARBORBOX_MAX_CONCURRENT_EXECUTIONS_PER_SANDBOX=1
# Not a tick any more. The scheduler is woken by a Postgres NOTIFY when work is
# enqueued; this is the fallback timeout that makes a missed notification cost
# one interval instead of stalling, and the interval on which work deferred for
# capacity is rescanned.
HARBORBOX_SCHEDULER_POLL_SECONDS=0.25
HARBORBOX_REAPER_POLL_SECONDS=5
HARBORBOX_MAX_UPLOAD_BYTES=157286400
HARBORBOX_DEFAULT_IDLE_TIMEOUT_SECONDS=300
# How long an SSE execution stream waits before sending a keepalive. Completion
# arrives by notification, so this only bounds silence on the wire.
HARBORBOX_EXECUTION_STREAM_KEEPALIVE_SECONDS=15

# The hot tier of the idle ladder: running -> paused_memory -> paused_cold.
# A sandbox idle this long is frozen rather than snapshotted, so the container
# and its warm interpreter survive and resuming is an unfreeze. It still goes
# cold at DEFAULT_IDLE_TIMEOUT_SECONDS. Set to 0 to disable the tier.
HARBORBOX_HOT_PAUSE_IDLE_SECONDS=60
# A frozen sandbox holds its full memory reservation, so the tier is capped;
# past this total, idle sandboxes go straight to cold. 0 also disables it.
HARBORBOX_HOT_PAUSE_BUDGET_MB=2048

# The rootless builder and the registry it pushes to. The builder is a separate
# Compose project (compose.builder.yaml) because a build step runs inside
# buildkitd's network namespace, so every network that container joins is one a
# caller's `RUN` can reach -- including the one an orchestrator appends to every
# service of an application. compose.yaml sets all of these; they are here for
# deployments that do not use it.
#
# The address is TCP because a unix socket cannot cross Compose projects, and
# these certificates are what keep that from being a downgrade: buildkitd
# requires a client certificate, and Harborbox refuses to start with a tcp://
# builder and none configured. Issue them with ./scripts/gen-buildkit-certs.sh,
# which writes Docker volumes and nothing into the working tree.
HARBORBOX_BUILDER_ADDRESS=tcp://buildkit-gateway:1234
HARBORBOX_BUILDER_TLS_CA_CERT=/certs/buildkit/ca.pem
HARBORBOX_BUILDER_TLS_CERT=/certs/buildkit/cert.pem
HARBORBOX_BUILDER_TLS_KEY=/certs/buildkit/key.pem
# Only if the name dialled above is not one of the server certificate's SANs.
HARBORBOX_BUILDER_TLS_SERVER_NAME=
# Two addresses for one registry: BuildKit dials the first from the build
# network, the *Docker daemon* resolves the second from the host when a sandbox
# is created. Everything after the host part must be identical on both sides.
HARBORBOX_REGISTRY_PUSH_ENDPOINT=registry:5000
HARBORBOX_REGISTRY_PULL_ENDPOINT=127.0.0.1:5050
HARBORBOX_REGISTRY_USERNAME=harborbox
HARBORBOX_REGISTRY_PASSWORD=replace-with-a-long-random-secret
# BuildKit has no implicit "localhost is insecure" rule, so plain HTTP has to
# be declared.
HARBORBOX_REGISTRY_INSECURE=true

# Legacy-only direct Docker settings. The default OpenSandbox provider ignores
# these; configure stronger isolation in OpenSandbox instead.
HARBORBOX_SANDBOX_RUNTIME=
HARBORBOX_SANDBOX_EGRESS_NETWORK=

# Onvo profile defaults; increase memory/concurrency only when host capacity allows.
HARBORBOX_ONVO_SANDBOX_MEMORY_MB=1024
HARBORBOX_ONVO_SANDBOX_CPU=2
HARBORBOX_ONVO_CONCURRENCY=2
HARBORBOX_ONVO_IDLE_TIMEOUT_SECONDS=1200

# Where scripts/gen-buildkit-certs.sh writes the buildkit mutual-TLS pair, and
# where both applications bind-mount it from. Required, absolute, and identical
# on both: Coolify deploys from an ephemeral /artifacts checkout, so a relative
# path resolves into a directory that is deleted after the build.
HARBORBOX_BUILDKIT_TLS_DIR=/data/harborbox/buildkit-tls

# Telemetry. Unset by default and meant to stay that way locally: with no
# endpoint Harborbox instruments nothing, so a local stack neither pays for
# spans nor posts into the estate's SigNoz. DEV-1824 is what that default is
# worth -- developer laptops exporting under the production service name made
# 94% of "production" errors somebody's local build.
#
# Production sets these (see compose.internal-tools.yaml): the public ingester
# rather than SigNoz over localhost, because a SigNoz outage should not also
# take the telemetry explaining it, and the ingestion key because an
# unauthenticated batch is dropped at the door -- indistinguishable from
# sending nothing, which is the failure DEV-1948 was filed for.
#
# Safe to point at the real ingester from a laptop: HARBORBOX_ENVIRONMENT below
# stays `development`, which exports under `harborbox-dev` rather than the
# `harborbox` name the daily checkup queries.
HARBORBOX_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
